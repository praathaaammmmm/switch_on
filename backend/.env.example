# Copy to .env (./dev up does this for you with random values). Never commit .env.
POSTGRES_PASSWORD=change-me
# development enables /internal/v1 (when INTERNAL_API_TOKEN is set) and demo seeding. Use production anywhere real.
APP_ENV=development
INTERNAL_API_TOKEN=change-me-too
# Give every new guest the demo repairs (development only).
SEED_DEMO_DATA=true
DB_PORT=5433
API_PORT=8080
