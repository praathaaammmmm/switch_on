# Copy to .env (./dev up does this for you with random values). Never commit .env.
POSTGRES_PASSWORD=change-me
# development enables /internal/v1 (when INTERNAL_API_TOKEN is set) and demo seeding. Use production anywhere real.
APP_ENV=development
INTERNAL_API_TOKEN=change-me-too
# Give every new guest the demo repairs (development only).
SEED_DEMO_DATA=true
DB_PORT=5433
API_PORT=8080
# Admin dashboard (development only): the owner account created on first start. ./dev up fills in a random password.
# Sign in at http://localhost:5173 with these. Production never seeds an account from the environment.
ADMIN_OWNER_EMAIL=owner@switchon.local
ADMIN_OWNER_PASSWORD=change-me-to-a-long-password
